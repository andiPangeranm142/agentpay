# AgentPay agent service — copy to .env and fill in. NEVER commit a real .env.
# Session keys are LEAST-PRIVILEGE: a session key can ONLY call pay() on the
# vault, ONLY to allowlisted payees, ONLY within per-tx + daily limits, and
# ONLY until expiry/revocation. A leaked session key CANNOT drain the vault
# (it cannot withdraw, cannot create sessions, cannot change limits).

# --- Chain ---
# Aevum Testnet (chain 44005). For local e2e use http://127.0.0.1:8545 + 31337.
RPC_URL=https://rpc-test.qday.info
CHAIN_ID=44005

# --- Contracts ---
# Deployed AgentPayVault address (set after deployment).
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
# tUSD8 on Aevum Testnet (6 decimals).
TOKEN_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# --- Session keys (ONE of the two styles; SESSION_KEYS_JSON wins if both set) ---
# JSON map of sessionId -> private key hex. Keys below are the PUBLIC anvil
# throwaway defaults — replace with your real session keys (generated per
# session via the web UI / owner tooling). NEVER paste the vault owner's key.
SESSION_KEYS_JSON={"0":"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"}
# Per-session alternative:
# SESSION_KEY_0=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Service ---
# Poll interval in ms (default 30000).
POLL_INTERVAL_MS=30000
# Localhost status endpoint port (default 3100). Bound to 127.0.0.1 only.
STATUS_PORT=3100
# Paths (relative to this folder).
SCHEDULES_PATH=./schedules.json
STATE_PATH=./state/agent-state.json
LOG_PATH=./logs/agent.log

# --- Resilience ---
# Max attempts for RPC/network failures (reverts are NOT retried).
MAX_RETRIES=5
# Base backoff in ms; delays are base * 2^attempt + jitter.
RETRY_BASE_MS=1000
