# AgentPay dashboard — environment variables (copy to .env, never commit .env)
# Leave VITE_VAULT_ADDRESS empty to run in MOCK MODE (demo data, no wallet needed
# to review the UI). Set it to the deployed AgentPayVault address to go live.
# A deployments.json placed in public/ overrides these values at runtime —
# see README.md.

# Deployed AgentPayVault contract on Aevum Testnet (chain 44005)
VITE_VAULT_ADDRESS=

# tUSD8 ERC-20 (6 decimals) — defaults to the known testnet address
# VITE_TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Aevum Testnet RPC + explorer (defaults are the public endpoints)
# VITE_RPC_URL=https://rpc-test.qday.info
# VITE_EXPLORER_URL=https://explorer-test.qday.info
