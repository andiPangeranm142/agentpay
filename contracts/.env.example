# AgentPay — contracts. Copy to .env and fill in. NEVER commit a real .env.

# Aevum testnet RPC (chain 44005)
AEVUM_RPC_URL=https://rpc-test.qday.info

# tUSD8 (6 decimals) on Aevum testnet — default in the deploy script; override only if needed
TUSD8=0x456569838f1d43009A91ebA4263147Afd7233483

# Deployer key — prefer a Foundry keystore instead:
#   cast wallet import agentpay-deployer --interactive
#   forge script script/Deploy.s.sol --rpc-url aevum --broadcast --legacy --account agentpay-deployer
# Only use the env var below as a fallback, and never share or commit it.
DEPLOYER_PRIVATE_KEY=
